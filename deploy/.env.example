# bilirec + bilirec-web compose environment example (FEATURES-V2 / v0.3.0).
#
#   cp deploy/.env.example deploy/.env    # first-time setup (deploy/.env is gitignored)
#   # edit deploy/.env, then rebuild/restart (see deploy/README.md "Rebuild / upgrade")
#   docker compose -f deploy/docker-compose.yml up -d --build
#
# This file is read by Docker Compose both for ${...} interpolation and, through
# the bilirec service's optional env_file, as container environment. Lines
# starting with `#` are ignored; uncomment a key to set it.
#
# All FEATURES-V2 settings are also editable at runtime through the REST API
# (GET/PUT /settings, POST /settings/reset) and per room (PUT /room/<id>/config).
# Env values are the *defaults* for sessions that have no persisted settings
# override; global/room overrides win over env. Invalid env values fall back to
# the built-in default and are logged once at backend startup.

# ---------------------------------------------------------------------------
# Publishing (compose interpolation only)
# ---------------------------------------------------------------------------
BILIREC_PORT=8080
WEB_PORT=8081
# Image version reported by /version (compose build arg VERSION; build.sh uses
# `git describe` by default). Leave unset for a local "dev" build.
#BILIREC_VERSION=v0.4.0
# Container user/group for the writable volumes. The entrypoint adjusts the
# bilirec user/group to these ids, chowns config/secrets/database/records and
# drops privileges (combined images keep nginx on root).
#PUID=10001
#PGID=10001
# CONFIG-V2 config center files (live in the `config` volume mounted at
# /app/config; secrets.json is written with mode 0600). Leave the paths as-is
# unless you mount custom files elsewhere.
#CONFIG_FILE=/app/config/config.json
#SECRETS_FILE=/app/config/secrets.json
# Origins allowed to call the API (frontend origin(s), comma-separated).
FRONTEND_URLS=http://localhost:8081
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# Bilibili login (see bilirec README for cookie/QR flows)
# anonymous | controller (QR login via UI/API) | startup
# ---------------------------------------------------------------------------
BILIBILI_LOGIN_MODE=controller

# Optional HTTP API auth. Setting USERNAME+PASSWORD enables JWT auth:
# GET /settings -> admin+viewer, PUT /settings + POST /settings/reset -> admin,
# PUT /room/<id>/config -> admin. Leave both empty for an open API.
# PASSWORD/VIEWER_PASSWORD are plain values here; the backend bcrypt-hashes
# them at startup. Set JWT_SECRET on every instance behind a proxy.
#USERNAME=admin
#PASSWORD=change-me
#VIEWER_USERNAME=viewer
#VIEWER_PASSWORD=change-me-too
#JWT_SECRET=replace-with-random-hex

# ---------------------------------------------------------------------------
# Recording pipeline (docs/INTERFACES.md §2.3) — defaults reproduce native v0.3.1
# ---------------------------------------------------------------------------
# auto | native | ffmpeg | streamlink (auto = native, no external downloader)
#DOWNLOADER=auto
#DOWNLOADER_FALLBACK=native
#FFMPEG_BIN=ffmpeg
#STREAMLINK_BIN=streamlink
#EXTERNAL_START_TIMEOUT_SECS=20
# auto | on | off (auto = on iff flvrepair resolves)
#FLV_REPAIR=auto
#FLV_REPAIR_BIN=/usr/local/bin/flvrepair
#FLV_REPAIR_MODE=best-effort
#FLV_REPAIR_MAX_BUFFER_MB=64

# upstream v0.4.0: preview connection queue cap (restart required).
# Each preview /preview/rooms/<id>/media connection has its own outbound queue
# cap (bytes); slow clients over the cap are disconnected (recording unaffected).
#PREVIEW_MEDIA_MAX_QUEUED_BYTES=4194304

# Stream-disconnect recovery: only retries while the room is still live; a normal
# stream end stops immediately. Window in seconds (default 30; 0 disables).
#MAX_RETRY_SECONDS=30
# Legacy alias accepted when MAX_RETRY_SECONDS is unset (minutes * 60); hidden
# from the settings UI.
#MAX_RETRY_MINUTES=1
#MAX_RECOVERY_ATTEMPTS=15

# Local file logging (default off). When enabled, split by logger source by
# default; HTTP access logs go to bilirec.log.d/access/current.log, main keeps
# application logs and all WARN/ERROR entries. Set SPLIT=false for the old
# single-file behavior.
#LOCAL_LOGS_ENABLED=true
#LOCAL_LOGS_SPLIT=true
#LOCAL_LOGS_GROUPS=live,system,recorder,access,update
#LOCAL_LOGS_PATH=/app/database/bilirec.log
#LOCAL_LOGS_FORMAT=pretty

# Webhook v2 targets (one URL per line); the settings UI has a test button.
#WEBHOOK_URLS=

# ---------------------------------------------------------------------------
# FEATURES-V2 settings defaults (docs/FEATURES-V2.md §1.1)
# These seed GET /settings `defaults`; persisted overrides (PUT /settings) and
# per-room overrides (PUT /room/<id>/config) win. Changes apply to NEW sessions.
# ---------------------------------------------------------------------------

# Segmentation (R02/B02): off | time | size. `segment_by_title` rotates when the
# live room title changes (poller tick TITLE_POLL_SECS, default 20, min 5).
#SEGMENT_MODE=off
#SEGMENT_MINUTES=120
#SEGMENT_SIZE_MB=2048
#SEGMENT_BY_TITLE=false
#TITLE_POLL_SECS=20

# Drop finished files smaller than this threshold (0 = disabled).
#MIN_FILE_SIZE_MB=0

# Naming (R03): available vars {roomid} {shortid} {uname} {title} {year}
# {month} {day} {hour} {minute} {second} {date} {time} {segment}; empty uses
# the legacy `{title}-{year}{month}{day}_{hour}{minute}{second}`. A `{segment}`
# suffix is also appended automatically for segment > 0.
#FILENAME_TEMPLATE={title}-{year}{month}{day}_{hour}{minute}{second}

# Title filter (R04): one RE2 regex per line; matching rooms are skipped by
# auto-record (manual POST /record/<id>/start still works). Empty = no filter.
#TITLE_FILTER_PATTERNS=

# Stream cover (R05): save <video basename>-cover.jpg next to the recording.
#SAVE_STREAM_COVER=false

# Danmaku (R06/R08): comma list of enabled types out of
# raw_events,super_chat,gift,guard (default = all except raw_events).
#DANMAKU_RECORD_TYPES=super_chat,gift,guard
# auto (wss with one ws fallback) | ws | wss. tcp is rejected by the API.
#DANMAKU_TRANSPORT=auto
# Existing sidecar options remain: jsonl|xml output format, overflow policy.
#DANMAKU_OUTPUT_FORMAT=jsonl
#DANMAKU_OVERFLOW_POLICY=drop

# FLV handling (R14): true = keep onMetaData/script tags in repaired FLV
# (default; maps to the sidecar's `--write-metadata keep`), false = drop them.
#FLV_WRITE_METADATA=true
# Split the segment when the upstream re-emits a Script tag after media data.
#FLV_SPLIT_ON_SCRIPT_TAG=false
# Disable splitting on Annex-B NALUs (true = tolerate Annex-B, odd but seen on
# some CDNs; set false to rotate instead).
#FLV_DISABLE_SPLIT_ON_ANNEXB=true

# Bilibili advanced fetching (B05). API host must reverse-proxy the same
# api.live.bilibili.com endpoints (including WBI); all failures fall back to the
# official host/original URLs and never block recording.
#BILI_LIVE_API_HOST=https://api.live.bilibili.com
#BILI_LIVE_API_FALLBACK_HOST=
# Comma list of up to 8 CDN names; empty = backend default CDN selection.
#BILI_CDN=
#BILI_CDN_FALLBACK=false
# Prefer TS/fMP4 source-quality profiles (qn>=10000) when allowed.
#BILI_FORCE_SOURCE=false
# Comma list of up to 8 host candidates for *-cn-gotcha01* URL replacement.
#BILI_REPLACE_CN01=

# Pinned image tags (build with these tags before `up`)
BILIREC_TAG=v0.3.0
WEB_TAG=v0.3.0

# 1 = full image (ffmpeg + streamlink: external downloaders + mp4 conversion)
# 0 = slim image (native recording only, no ffmpeg/streamlink)
WITH_EXTRA=1
